@model List<mvc_3_hw.Models.Product>

<h2>Каталог товаров</h2>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var product in Model)
    {
        <div class="col">
            <div class="card h-100">
                <img src="@product.UrlPhoto" class="card-img-top" alt="@product.Name"
                     style="object-fit: cover; height: 400px;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text">@product.Description</p>
                    <p class="text-muted mb-1">@product.Category</p>
                    <h5 class="text-primary">@product.Price ₽</h5>
                    <a class="btn btn-primary mt-auto"
                       asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">Подробнее</a>
                </div>
            </div>
        </div>
    }
</div>