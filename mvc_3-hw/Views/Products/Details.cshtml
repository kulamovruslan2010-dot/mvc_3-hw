@model mvc_3_hw.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="row">
    <div class="col-md-5">
        <img src="@Model.UrlPhoto" class="img-fluid rounded" alt="@Model.Name">
    </div>
    <div class="col-md-7">
        <h2>@Model.Name</h2>
        <p class="text-muted">Категория: @Model.Category</p>
        <h3 class="text-primary">@Model.Price ₽</h3>
        <p>@Model.Description</p>
        <a class="btn btn-secondary" asp-controller="Products" asp-action="Index">← Назад в каталог</a>
    </div>
</div>